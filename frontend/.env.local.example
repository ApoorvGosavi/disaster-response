# Public — safe to expose to the browser. The anon key has no
# power beyond what RLS policies grant an authenticated user.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the Express backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# SERVER-ONLY — never prefix with NEXT_PUBLIC_, never expose to
# the browser. Not used directly by the frontend app today, but
# reserved here in case a future Route Handler needs elevated
# access (e.g. server-side admin actions).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
